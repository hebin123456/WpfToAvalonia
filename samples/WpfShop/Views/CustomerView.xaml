<UserControl x:Class="WpfShop.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12">
        <TextBlock Text="{Binding CustomerName, FallbackValue=—}" FontWeight="Bold"/>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8"/>
        <CheckBox IsChecked="{Binding IsVip}" Content="VIP 客户" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
